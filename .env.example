# =============================================================================
# MediRush — environment variables (Next.js)
# =============================================================================
# Put secrets in `.env.local` in THIS folder (project root next to package.json).
# Next.js loads automatically: `.env.local` > `.env.development` > `.env`
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# When "true", /api/auth/send-otp JSON includes `demoOtp` even in production builds.
# Omit or "false" in real production unless you deliberately want QA OTP echoes.
MEDIRUSH_DEMO_OTP=

# Future integrations (examples — wire in code when ready)
# RESEND_API_KEY=
# DATABASE_URL=
